        public async Task<MenuRoleAccessResponse> GetMenuRoleAccess(int menuId, string userId)
        {
            try
            {
                var query = @"
                    SELECT 
                        mra_id, mra_menu_id, mra_role, mra_can_read, mra_can_create, mra_can_edit, mra_can_delete,
                        mra_created_date
                    FROM menu_role_access
                    WHERE mra_menu_id = @menuId
                    ORDER BY mra_role ASC";

                var parameters = new[] { new MySqlParameter("@menuId", menuId) };
                var result = await Task.Run(() => _dbHelper.ExecuteQuery(query, parameters));
                var roleAccess = new List<MenuRoleAccess>();

                foreach (DataRow row in result.Rows)
                {
                    roleAccess.Add(MapToMenuRoleAccess(row));
                }

                return new MenuRoleAccessResponse
                {
                    OutputCode = 1,
                    OutputMsg = $"Retrieved {roleAccess.Count} role access entries",
                    Data = roleAccess
                };
            }
            catch (Exception ex)
            {
                return new MenuRoleAccessResponse
                {
                    OutputCode = 0,
                    OutputMsg = $"Error retrieving role access: {ex.Message}",
                    Data = new List<MenuRoleAccess>()
                };
            }
        }

        public async Task<MenuRoleAccessResponse> SaveMenuRoleAccess(List<MenuRoleAccess> roleAccess, string userId)
        {
            try
            {
                if (roleAccess == null || roleAccess.Count == 0)
                {
                    return new MenuRoleAccessResponse
                    {
                        OutputCode = 0,
                        OutputMsg = "No role access data provided",
                        Data = new List<MenuRoleAccess>()
                    };
                }

                int successCount = 0;

                foreach (var access in roleAccess)
                {
                    var checkQuery = @"
                        SELECT COUNT(*) as cnt FROM menu_role_access
                        WHERE mra_menu_id = @menuId AND mra_role = @role";

                    var checkParams = new[]
                    {
                        new MySqlParameter("@menuId", access.MraMenuId),
                        new MySqlParameter("@role", access.MraRole)
                    };

                    var checkResult = await Task.Run(() => _dbHelper.ExecuteQuery(checkQuery, checkParams));
                    var exists = checkResult.Rows.Count > 0 && Convert.ToInt32(checkResult.Rows[0]["cnt"]) > 0;

                    string query;
                    MySqlParameter[] parameters;

                    if (exists)
                    {
                        query = @"
                            UPDATE menu_role_access
                            SET mra_can_read = @canRead, mra_can_create = @canCreate,
                                mra_can_edit = @canEdit, mra_can_delete = @canDelete
                            WHERE mra_menu_id = @menuId AND mra_role = @role";

                        parameters = new[]
                        {
                            new MySqlParameter("@menuId", access.MraMenuId),
                            new MySqlParameter("@role", access.MraRole),
                            new MySqlParameter("@canRead", access.MraCanRead),
                            new MySqlParameter("@canCreate", access.MraCanCreate),
                            new MySqlParameter("@canEdit", access.MraCanEdit),
                            new MySqlParameter("@canDelete", access.MraCanDelete)
                        };
                    }
                    else
                    {
                        query = @"
                            INSERT INTO menu_role_access (mra_menu_id, mra_role, mra_can_read, mra_can_create,
                                mra_can_edit, mra_can_delete, mra_created_date)
                            VALUES (@menuId, @role, @canRead, @canCreate, @canEdit, @canDelete, UTC_TIMESTAMP())";

                        parameters = new[]
                        {
                            new MySqlParameter("@menuId", access.MraMenuId),
                            new MySqlParameter("@role", access.MraRole),
                            new MySqlParameter("@canRead", access.MraCanRead),
                            new MySqlParameter("@canCreate", access.MraCanCreate),
                            new MySqlParameter("@canEdit", access.MraCanEdit),
                            new MySqlParameter("@canDelete", access.MraCanDelete)
                        };
                    }

                    var rowsAffected = await Task.Run(() => _dbHelper.ExecuteNonQuery(query, parameters));
                    if (rowsAffected > 0) successCount++;
                }

                return new MenuRoleAccessResponse
                {
                    OutputCode = 1,
                    OutputMsg = $"Saved {successCount}/{roleAccess.Count} role access entries successfully",
                    Data = roleAccess
                };
            }
            catch (Exception ex)
            {
                return new MenuRoleAccessResponse
                {
                    OutputCode = 0,
                    OutputMsg = $"Error saving role access: {ex.Message}",
                    Data = new List<MenuRoleAccess>()
                };
            }
        }

        public async Task<List<AdminMenu>> GetMenusByUserRole(string userRole)
        {
            try
            {
                var query = @"
                    SELECT DISTINCT
                        admin_menus.am_id, admin_menus.am_code, admin_menus.am_name, admin_menus.am_icon, 
                        admin_menus.am_action, admin_menus.am_controller, admin_menus.am_order_no, 
                        admin_menus.am_parent_id, admin_menus.am_active, admin_menus.am_menu_type,
                        admin_menus.am_created_date, admin_menus.am_created_user, 
                        admin_menus.am_modified_date, admin_menus.am_modified_user
                    FROM admin_menus
                    INNER JOIN menu_role_access ON admin_menus.am_id = menu_role_access.mra_menu_id
                    WHERE admin_menus.am_active = 'Y' 
                      AND menu_role_access.mra_role = @roleCode 
                      AND menu_role_access.mra_can_read = 'Y'
                    ORDER BY admin_menus.am_order_no ASC";

                var parameters = new[] { new MySqlParameter("@roleCode", userRole) };
                var result = await Task.Run(() => _dbHelper.ExecuteQuery(query, parameters));
                var menus = new List<AdminMenu>();

                foreach (DataRow row in result.Rows)
                {
                    menus.Add(MapToAdminMenu(row));
                }

                return menus;
            }
            catch (Exception ex)
            {
                // Log error but return empty list instead of throwing
                return new List<AdminMenu>();
            }
        }
        
        private AdminMenu MapToAdminMenu(DataRow row)
        {
            return new AdminMenu
            {
                AmId = row["am_id"] != DBNull.Value ? Convert.ToInt32(row["am_id"]) : 0,
                AmCode = row["am_code"]?.ToString() ?? "",
                AmName = row["am_name"]?.ToString() ?? "",
                AmIcon = row["am_icon"]?.ToString() ?? "",
                AmAction = row["am_action"]?.ToString() ?? "",
                AmController = row["am_controller"]?.ToString() ?? "",
                AmOrderNo = row["am_order_no"] != DBNull.Value ? Convert.ToInt32(row["am_order_no"]) : 0,
                AmParentId = row["am_parent_id"] != DBNull.Value ? Convert.ToInt32(row["am_parent_id"]) : null,
                AmActive = row["am_active"]?.ToString() ?? "Y",
                AmMenuType = row["am_menu_type"]?.ToString() ?? "page",
                AmCreatedDate = row["am_created_date"] != DBNull.Value ? (DateTime?)row["am_created_date"] : null,
                AmCreatedUser = row["am_created_user"]?.ToString() ?? "",
                AmModifiedDate = row["am_modified_date"] != DBNull.Value ? (DateTime?)row["am_modified_date"] : null,
                AmModifiedUser = row["am_modified_user"]?.ToString() ?? ""
            };
        }

        private MenuRoleAccess MapToMenuRoleAccess(DataRow row)
        {
            return new MenuRoleAccess
            {
                MraId = row["mra_id"] != DBNull.Value ? Convert.ToInt32(row["mra_id"]) : 0,
                MraMenuId = row["mra_menu_id"] != DBNull.Value ? Convert.ToInt32(row["mra_menu_id"]) : 0,
                MraRole = row["mra_role"]?.ToString() ?? "",
                MraCanRead = row["mra_can_read"]?.ToString() ?? "N",
                MraCanCreate = row["mra_can_create"]?.ToString() ?? "N",
                MraCanEdit = row["mra_can_edit"]?.ToString() ?? "N",
                MraCanDelete = row["mra_can_delete"]?.ToString() ?? "N",
                MraCreatedDate = row["mra_created_date"] != DBNull.Value ? (DateTime?)row["mra_created_date"] : null
            };
        }
    }
