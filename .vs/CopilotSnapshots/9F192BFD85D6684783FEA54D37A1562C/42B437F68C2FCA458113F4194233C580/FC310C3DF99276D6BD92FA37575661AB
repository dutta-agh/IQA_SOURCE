-- ========================================================================
-- 7. SET MENU ACCESS FOR ADMIN ROLE (can access all menus)
-- ========================================================================
INSERT INTO menu_role_access (menu_id, role_code, can_read, can_create, can_edit, can_delete)
SELECT m.menu_id, 'Admin', 'Y', 'Y', 'Y', 'Y'
FROM admin_menus m
WHERE m.menu_type != 'divider'
ON DUPLICATE KEY UPDATE
  can_read = 'Y',
  can_create = 'Y',
  can_edit = 'Y',
  can_delete = 'Y';

-- ========================================================================
-- 8. SET MENU ACCESS FOR MANAGER ROLE
-- ========================================================================
-- Manager can access most menus but cannot access Admin Users and Admin Menus
INSERT INTO menu_role_access (menu_id, role_code, can_read, can_create, can_edit, can_delete)
SELECT m.menu_id, 'Manager', 'Y', 'Y', 'Y', 'Y'
FROM admin_menus m
WHERE m.menu_type != 'divider'
  AND m.menu_code NOT IN ('admin_users', 'admin_menus', 'bulk_operations')
ON DUPLICATE KEY UPDATE
  can_read = 'Y',
  can_create = 'Y',
  can_edit = 'Y',
  can_delete = 'Y';

-- ========================================================================
-- 9. SET MENU ACCESS FOR OPERATOR ROLE
-- ========================================================================
-- Operator has read-only or limited write access to data entry menus
INSERT INTO menu_role_access (menu_id, role_code, can_read, can_create, can_edit, can_delete)
SELECT m.menu_id, 'Operator', 'Y', 'Y', 'Y', 'N'
FROM admin_menus m
WHERE m.menu_type != 'divider'
  AND m.menu_code IN (
    'dashboard',
    'images_master',
    'image_groups',
    'assessment_images',
    'question_answers',
    'speed_test_logs'
  )
ON DUPLICATE KEY UPDATE
  can_read = 'Y',
  can_create = 'Y',
  can_edit = 'Y',
  can_delete = 'N';

-- ========================================================================
-- 10. SET MENU ACCESS FOR VIEWER ROLE (Read-only)
-- ========================================================================
-- Viewer can only read data
INSERT INTO menu_role_access (menu_id, role_code, can_read, can_create, can_edit, can_delete)
SELECT m.menu_id, 'Viewer', 'Y', 'N', 'N', 'N'
FROM admin_menus m
WHERE m.menu_type != 'divider'
  AND m.menu_code IN (
    'dashboard',
    'assessment_images',
    'question_answers',
    'speed_test_logs'
  )
ON DUPLICATE KEY UPDATE
  can_read = 'Y',
  can_create = 'N',
  can_edit = 'N',
  can_delete = 'N';

-- ========================================================================
-- SUMMARY OF ACCESS PERMISSIONS:
-- ========================================================================
-- Admin:    Full access to all menus (CRUD operations)
-- Manager:  Can manage most content except admin-level features
--           - CAN access: Dashboard, Content, Assessment, Questions, Images, Reports
--           - CANNOT access: Admin Users, Admin Menus, Bulk Operations
-- Operator: Limited to data entry with no delete permission
--           - CAN READ & CREATE & EDIT: Dashboard, Images, Assessment Images, Q&A, Speed Tests
--           - CANNOT DELETE: Any menu item
-- Viewer:   Read-only access to reports
--           - CAN READ: Dashboard, Assessment Images, Question Answers, Speed Test Logs
--           - CANNOT: Create, Edit, Delete
-- ========================================================================

-- Verify the setup
SELECT 'Admin Roles:' AS section;
SELECT * FROM admin_roles;

SELECT '' AS '';
SELECT 'Admin Menus:' AS section;
SELECT menu_id, menu_code, menu_name, menu_icon, menu_order, menu_type, is_active
FROM admin_menus
ORDER BY menu_order;

SELECT '' AS '';
SELECT 'Menu Role Access Summary:' AS section;
SELECT 
    r.role_name,
    COUNT(DISTINCT mra.menu_id) AS accessible_menus,
    SUM(IF(mra.can_read = 'Y', 1, 0)) AS can_read,
    SUM(IF(mra.can_create = 'Y', 1, 0)) AS can_create,
    SUM(IF(mra.can_edit = 'Y', 1, 0)) AS can_edit,
    SUM(IF(mra.can_delete = 'Y', 1, 0)) AS can_delete
FROM admin_roles r
LEFT JOIN menu_role_access mra ON r.role_code = mra.role_code
GROUP BY r.role_id, r.role_name;
