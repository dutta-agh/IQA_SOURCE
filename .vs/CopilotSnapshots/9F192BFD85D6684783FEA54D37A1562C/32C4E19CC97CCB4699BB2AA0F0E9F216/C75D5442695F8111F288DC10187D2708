@* Updated Admin Layout with Dynamic Menu Loading *@
@{
    var currentPage = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IQA Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Global App Configuration - MUST be loaded FIRST -->
    @await Html.PartialAsync("_AppConfigScript")
    
    <!-- jQuery FIRST - Load from local before any other scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Expose jQuery globally immediately
        if (typeof jQuery !== 'undefined') {
            window.$ = jQuery;
            window.jQueryReady = true;
        }
    </script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f6fa;
            overflow-x: hidden;
        }

        /* Loader Overlay */
        .loader-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5); display: none;
            justify-content: center; align-items: center; z-index: 9999;
        }
        .loader-overlay.show { display: flex; }
        .spinner {
            border: 5px solid #f3f3f3; border-top: 5px solid #667eea;
            border-radius: 50%; width: 60px; height: 60px;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .loader-text { color: white; margin-top: 15px; font-size: 1.1rem; }

        /* Alert Container */
        .alert-container { position: fixed; top: 20px; right: 20px; z-index: 9998; max-width: 400px; }

        /* Sidebar */
        .sidebar {
            position: fixed; left: 0; top: 0; height: 100vh; width: 260px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px 0; transition: all 0.3s ease; z-index: 1000;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1); overflow-y: auto;
        }
        .sidebar.collapsed { width: 80px; }
        .sidebar-header { padding: 0 20px; margin-bottom: 30px; color: white; display: flex; align-items: center; justify-content: center; }
        .sidebar-header h4 { font-size: 1.5rem; font-weight: 600; white-space: nowrap; overflow: hidden; }
        .sidebar.collapsed .sidebar-header h4 span { display: none; }
        .sidebar-menu { list-style: none; padding: 0; }
        .menu-item { margin-bottom: 5px; }
        .menu-divider { border-top: 1px solid rgba(255,255,255,0.15); margin: 8px 20px; }
        .sidebar.collapsed .menu-divider { margin: 8px 10px; }
        .menu-link {
            display: flex; align-items: center; padding: 15px 20px;
            color: rgba(255,255,255,0.8); text-decoration: none; transition: all 0.3s; position: relative;
        }
        .menu-link:hover, .menu-link.active { background: rgba(255,255,255,0.1); color: white; }
        .menu-icon { font-size: 1.2rem; width: 30px; margin-right: 15px; }
        .sidebar.collapsed .menu-text { display: none; }

        /* Main Content */
        .main-content { margin-left: 260px; min-height: 100vh; transition: all 0.3s ease; }
        .main-content.expanded { margin-left: 80px; }

        /* Top Navbar */
        .top-navbar {
            background: white; padding: 15px 30px; display: flex;
            justify-content: space-between; align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1); position: sticky; top: 0; z-index: 999;
        }
        .toggle-btn { background: none; border: none; font-size: 1.5rem; color: #667eea; cursor: pointer; transition: all 0.3s; }
        .toggle-btn:hover { color: #764ba2; }
        .user-info { display: flex; align-items: center; gap: 20px; }
        .user-info span { font-weight: 500; color: #333; }
        .logout-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; padding: 8px 20px;
            border-radius: 5px; cursor: pointer; transition: all 0.3s;
        }
        .logout-btn:hover { opacity: 0.9; transform: translateY(-2px); }

        /* Content Area */
        .content-area { padding: 30px; min-height: calc(100vh - 70px); }

        @@media (max-width: 768px) {
            .sidebar { width: 80px; }
            .sidebar .menu-text { display: none; }
            .main-content { margin-left: 80px; }
            .sidebar-header h4 span { display: none; }
        }

        .content-area{
            zoom:0.76 !important;
        }

        .sidebar-menu{
            zoom: 0.85 !important;
        }
    </style>
    
    @await RenderSectionAsync("Styles", required: false)

    <script type="text/javascript">
        window.history.pushState(null, "", window.location.href);
        window.onpopstate = function () { window.history.pushState(null, "", window.location.href); };
    </script>
</head>
<body>
    <!-- Loader Overlay -->
    <div class="loader-overlay" id="loaderOverlay">
        <div class="text-center">
            <div class="spinner"></div>
            <div class="loader-text">Loading...</div>
        </div>
    </div>

    <!-- Alert Container -->
    <div class="alert-container" id="alertContainer"></div>

    <!-- Dynamic Sidebar (loaded from partial view) -->
    @await Html.PartialAsync("_AdminSidebar")

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <nav class="top-navbar">
            <button class="toggle-btn" id="toggleBtn"><i class="fas fa-bars"></i></button>
            <div class="user-info">
                <span><i class="fas fa-user-circle"></i> <span id="userName">Admin User</span></span>
                <button class="logout-btn" onclick="showLogoutConfirmation()">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
        </nav>
        <div class="content-area">
            @RenderBody()
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationModalTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmationModalBody">Are you sure you want to proceed?</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmationModalConfirm">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery from local wwwroot (guaranteed and fast) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- CRITICAL: Make jQuery immediately available globally -->
    <script>
        if (typeof jQuery !== 'undefined') {
            window.$ = jQuery;
            window.jQueryReady = true;
        }
    </script>

    <!-- Load sidebar via AJAX AFTER jQuery is available -->
    <script>
        // Load sidebar dynamically after jQuery is ready
        function loadSidebarMenu() {
            $.ajax({
                url: buildApiUrl('/Admin/GetSidebarHtml'),
                type: 'GET',
                success: function(html) {
                    $('#sidebarContainer').html(html);
                    // Reinitialize sidebar toggle after sidebar is loaded
                    $('#toggleBtn').off('click').on('click', function () {
                        $('#sidebar').toggleClass('collapsed');
                        $('#mainContent').toggleClass('expanded');
                    });
                },
                error: function(xhr, status, error) {
                    console.error('Error loading sidebar:', error);
                    // Fallback: Load sidebar partial synchronously if AJAX fails
                    loadSidebarFallback();
                }
            });
        }

        // Fallback sidebar loading
        function loadSidebarFallback() {
            $.get(buildApiUrl('/Admin/GetSidebarHtml'), function(data) {
                $('#sidebarContainer').html(data);
            });
        }

        // Load sidebar when jQuery is ready
        if (typeof $ !== 'undefined') {
            $(document).ready(function() {
                loadSidebarMenu();
            });
        }
    </script>

    <script>
        // ?? Global Select2 initialiser — runs after page scripts so dynamic selects are caught ??
        function initSelect2(context) {
            var scope = context || document;
            $(scope).find('select').not('.no-select2').not('.select2-hidden-accessible').each(function () {
                var $el       = $(this);
                var inModal   = $el.closest('.modal').length > 0;
                var opts = {
                    theme:            'material',
                    width:            '100%',
                    allowClear:       $el.find('option[value=""]').length > 0,
                    placeholder:      $el.find('option[value=""]').text() || 'Select...',
                    dropdownParent:   inModal ? $el.closest('.modal') : $(document.body)
                };
                $el.select2(opts);
            });
        }

        // Re-init inside a modal when it opens (handles dynamically populated selects)
        $(document).on('shown.bs.modal', function (e) {
            initSelect2(e.target);
        });

        // ?? Loader ???????????????????????????????????????????????????????????????
        function showLoader() { document.getElementById('loaderOverlay').classList.add('show'); }
        function hideLoader() { document.getElementById('loaderOverlay').classList.remove('show'); }

        // ?? Alerts ???????????????????????????????????????????????????????????????
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();
            const icon = type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle';
            alertContainer.insertAdjacentHTML('beforeend', `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${icon}"></i> ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`);
            setTimeout(() => {
                const el = document.getElementById(alertId);
                if (el) new bootstrap.Alert(el).close();
            }, 5000);
        }

        // ?? Confirmation Modal ????????????????????????????????????????????????????
        function showConfirmationModal(title, message, onConfirm, confirmBtnText = 'Confirm', confirmBtnClass = 'btn-primary') {
            const modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
            document.getElementById('confirmationModalTitle').textContent = title;
            document.getElementById('confirmationModalBody').textContent  = message;
            const confirmBtn = document.getElementById('confirmationModalConfirm');
            confirmBtn.textContent  = confirmBtnText;
            confirmBtn.className    = 'btn ' + confirmBtnClass;
            const newBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newBtn, confirmBtn);
            newBtn.addEventListener('click', function () { modal.hide(); onConfirm(); });
            modal.show();
        }

        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // ?? Sidebar Toggle ????????????????????????????????????????????????????????
        $('#toggleBtn').on('click', function () {
            $('#sidebar').toggleClass('collapsed');
            $('#mainContent').toggleClass('expanded');
        });

        function showLogoutConfirmation() {
            showConfirmationModal('Confirm Logout', 'Are you sure you want to logout?', logout, 'Logout', 'btn-danger');
        }

        function logout() {
            showLoader();
            $.ajax({
                url: buildApiUrl('/Admin/Logout'), type: 'POST',
                success: function () { window.location.href = buildApiUrl('/Admin/Login'); },
                error:   function () { hideLoader(); showAlert('Error during logout', 'danger'); }
            });
        }

        // ?? Boot Select2 after all page scripts have run ?????????????????????????
        $(document).ready(function () { initSelect2(); });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Re-run Select2 after page-level scripts (e.g. scripts that add options dynamically)
        $(document).ready(function () { initSelect2(); });
    </script>
</body>
</html>
