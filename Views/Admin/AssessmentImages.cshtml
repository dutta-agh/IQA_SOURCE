@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Assessment Images";
}

@section Styles {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            --card-shadow-hover: 0 8px 16px rgba(102, 126, 234, 0.2);
            --border-radius: 12px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ── Page Layout ── */
        .page-header {
            background: var(--primary-gradient);
            border-radius: var(--border-radius);
            padding: 25px 30px;
            margin-bottom: 25px;
            color: white;
            box-shadow: var(--card-shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .page-header h2 { margin: 0; font-size: 1.75rem; font-weight: 600; display: flex; align-items: center; gap: 12px; }

        .filter-section { background: white; border-radius: var(--border-radius); padding: 20px; box-shadow: var(--card-shadow); margin-bottom: 20px; }
        .filter-group { display: flex; gap: 15px; align-items: end; flex-wrap: wrap; }
        .filter-group .form-group { flex: 1; min-width: 250px; margin-bottom: 0; }
        .filter-group .btn-group { display: flex; gap: 10px; }

        .btn-modern { padding: 10px 24px; border-radius: 8px; font-weight: 500; transition: var(--transition); border: none; display: flex; align-items: center; gap: 8px; }
        .btn-modern:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }
        .btn-primary-modern { background: var(--primary-gradient); color: white; }
        .btn-secondary-modern { background: #e9ecef; color: #495057; }
        .btn-back { background: white; color: #667eea; border: 2px solid white; }
        .btn-back:hover { background: rgba(255,255,255,0.9); }

        /* ── Gallery Grid ── */
        .images-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; margin-top: 20px; }
        .image-item { background: white; border-radius: var(--border-radius); overflow: hidden; box-shadow: var(--card-shadow); transition: var(--transition); }
        .image-item:hover { transform: translateY(-5px); box-shadow: var(--card-shadow-hover); }

        .image-preview-container { position: relative; width: 100%; height: 220px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); overflow: hidden; display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .image-preview-main { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform 0.3s; }
        .image-preview-container:hover .image-preview-main { transform: scale(1.04); }

        .image-badge { position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,0.95); padding: 6px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; display: flex; align-items: center; gap: 5px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .open-gallery-hint { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); background: rgba(102,126,234,0.85); color: white; padding: 5px 14px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; opacity: 0; transition: opacity 0.25s; white-space: nowrap; }
        .image-preview-container:hover .open-gallery-hint { opacity: 1; }

        .image-details { padding: 18px; }
        .image-title { font-weight: 600; color: #2d3748; margin-bottom: 10px; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }
        .image-title i { color: #667eea; }

        .image-meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 12px; }
        .meta-item { font-size: 0.8rem; color: #718096; display: flex; align-items: center; gap: 6px; }
        .meta-item i { color: #667eea; width: 14px; }
        .meta-value { font-weight: 500; color: #2d3748; }

        .linked-images-section { border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 12px; }
        .linked-images-title { font-size: 0.85rem; font-weight: 600; color: #4a5568; margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
        .linked-images-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); gap: 8px; }
        .linked-image-thumb { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 2px solid #e2e8f0; transition: var(--transition); cursor: pointer; }
        .linked-image-thumb:hover { border-color: #667eea; transform: scale(1.06); }
        .linked-image-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .quality-badge { position: absolute; bottom: 2px; right: 2px; background: rgba(0,0,0,0.75); color: white; font-size: 0.63rem; padding: 2px 5px; border-radius: 4px; font-weight: 600; pointer-events: none; }
        .quality-badge.enhanced { background: linear-gradient(135deg, #667eea, #764ba2); }
        .quality-badge.degraded { background: linear-gradient(135deg, #f093fb, #f5576c); }

        .audit-section { background: #f7fafc; border-radius: 8px; padding: 12px; margin-top: 12px; border-left: 3px solid #667eea; }
        .audit-title { font-size: 0.8rem; font-weight: 600; color: #4a5568; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
        .audit-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
        .audit-item { font-size: 0.75rem; color: #718096; }
        .audit-item strong { color: #2d3748; font-weight: 500; }

        .stats-bar { display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; }
        .stat-chip { background: white; border-radius: 20px; padding: 8px 16px; box-shadow: var(--card-shadow); display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 500; }
        .stat-chip i { color: #667eea; }
        .stat-value { background: var(--primary-gradient); color: white; padding: 2px 8px; border-radius: 10px; font-weight: 600; }

        .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: var(--border-radius); box-shadow: var(--card-shadow); }
        .empty-state i { font-size: 4rem; color: #cbd5e0; margin-bottom: 20px; }
        .empty-state h4 { color: #4a5568; margin-bottom: 10px; }
        .empty-state p { color: #718096; }

        /* ════════════════════════════════════════
           LIGHTBOX / GALLERY MODAL
        ════════════════════════════════════════ */
        #galleryModal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 10000;
            background: rgba(8, 8, 18, 0.97);
            flex-direction: column;
        }
        #galleryModal.active { display: flex; }

        /* Header */
        .gm-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 20px;
            background: rgba(255,255,255,0.04);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
            min-height: 54px;
        }
        .gm-title {
            flex: 1;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .gm-counter {
            color: rgba(255,255,255,0.5);
            font-size: 0.82rem;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .gm-close {
            flex-shrink: 0;
            background: rgba(255,255,255,0.08);
            border: none;
            color: white;
            width: 34px; height: 34px;
            border-radius: 50%;
            font-size: 1rem;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.2s;
        }
        .gm-close:hover { background: rgba(239,68,68,0.6); }

        /* Body row: stage + info panel */
        .gm-body {
            display: flex;
            flex: 1;
            min-height: 0; /* critical: allows children to shrink */
            overflow: hidden;
        }

        /* ── Image Stage ── */
        .gm-stage {
            flex: 1;
            min-width: 0;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #0d0d1a;
        }
        .gm-stage-img {
            max-width: calc(100% - 130px); /* leave room for arrows */
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            border-radius: 6px;
            box-shadow: 0 8px 48px rgba(0,0,0,0.7);
            transition: opacity 0.18s ease;
            display: block;
            user-select: none;
        }
        .gm-stage-img.fading { opacity: 0; }

        .gm-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,0.10);
            border: 2px solid rgba(255,255,255,0.22);
            color: white;
            width: 50px; height: 50px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.2s, border-color 0.2s, transform 0.1s;
            z-index: 2;
            flex-shrink: 0;
        }
        .gm-arrow:hover { background: rgba(102,126,234,0.65); border-color: #667eea; }
        .gm-arrow:active { transform: translateY(-50%) scale(0.93); }
        .gm-arrow:disabled { opacity: 0.18; cursor: default; pointer-events: none; }
        #gmPrev { left: 16px; }
        #gmNext { right: 16px; }

        /* ── Info Panel ── */
        .gm-info-panel {
            width: 300px;
            min-width: 260px;
            max-width: 320px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: rgba(255,255,255,0.03);
            border-left: 1px solid rgba(255,255,255,0.07);
            overflow: hidden;
        }
        .gm-tabs {
            display: flex;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }
        .gm-tab {
            flex: 1;
            padding: 10px 4px;
            text-align: center;
            font-size: 0.73rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: color 0.18s, border-color 0.18s;
            user-select: none;
        }
        .gm-tab.active { color: #a78bfa; border-bottom-color: #a78bfa; }
        .gm-tab:hover:not(.active) { color: rgba(255,255,255,0.7); }

        .gm-info-body {
            flex: 1;
            overflow-y: auto;
            padding: 14px 12px;
        }
        .gm-info-body::-webkit-scrollbar { width: 4px; }
        .gm-info-body::-webkit-scrollbar-track { background: transparent; }
        .gm-info-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 2px; }

        .info-group-label {
            font-size: 0.63rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            margin: 14px 0 6px;
        }
        .info-group-label:first-child { margin-top: 0; }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 6px;
            padding: 5px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .info-row:last-child { border-bottom: none; }
        .info-k {
            color: rgba(255,255,255,0.42);
            font-size: 0.73rem;
            flex-shrink: 0;
            padding-top: 1px;
        }
        .info-v {
            color: rgba(255,255,255,0.88);
            font-size: 0.76rem;
            font-weight: 500;
            text-align: right;
            word-break: break-word;
            max-width: 180px;
        }

        .gm-quality-chip {
            display: inline-flex;
            align-items: center;
            padding: 2px 9px;
            border-radius: 10px;
            font-size: 0.7rem;
            font-weight: 700;
        }
        .gm-quality-chip.master   { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
        .gm-quality-chip.enhanced { background: linear-gradient(135deg, #43e97b, #38f9d7); color: #0d3322; }
        .gm-quality-chip.degraded { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }

        .no-data-msg {
            color: rgba(255,255,255,0.3);
            font-size: 0.78rem;
            text-align: center;
            margin-top: 20px;
        }

        /* ── Filmstrip ── */
        .gm-filmstrip {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            background: rgba(0,0,0,0.55);
            overflow-x: auto;
            border-top: 1px solid rgba(255,255,255,0.06);
        }
        .gm-filmstrip::-webkit-scrollbar { height: 3px; }
        .gm-filmstrip::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); border-radius: 2px; }

        .gm-thumb {
            flex-shrink: 0;
            width: 62px; height: 48px;
            border-radius: 6px;
            overflow: hidden;
            border: 2px solid transparent;
            cursor: pointer;
            position: relative;
            transition: border-color 0.18s, opacity 0.18s;
            opacity: 0.5;
        }
        .gm-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .gm-thumb.active { border-color: #a78bfa; opacity: 1; }
        .gm-thumb:not(.active):hover { opacity: 0.8; border-color: rgba(167,139,250,0.4); }

        .gm-thumb-lbl {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background: rgba(0,0,0,0.65);
            color: #fff;
            font-size: 0.55rem;
            font-weight: 700;
            text-align: center;
            padding: 1px 3px;
            pointer-events: none;
        }

        /* Responsive */
        @@media (max-width: 860px) {
            .gm-info-panel { display: none; }
        }
        @@media (max-width: 768px) {
            .images-grid { grid-template-columns: 1fr; }
            .page-header { flex-direction: column; gap: 15px; text-align: center; }
            .filter-group { flex-direction: column; }
            .filter-group .form-group { width: 100%; }
        }
    </style>
}

<div class="page-header">
    <h2><i class="fas fa-images"></i> Assessment Images Gallery</h2>
    <a href="@IQA_SOURCE.Constants.SubApplicationPathJS/Admin/Dashboard" class="btn btn-back btn-modern">
        <i class="fas fa-arrow-left"></i> Dashboard
    </a>
</div>

<div class="filter-section">
    <div class="filter-group">
        <div class="form-group">
            <label class="form-label fw-bold"><i class="fas fa-filter"></i> Assessment Type</label>
            <select class="form-select" id="assessmentTypeFilter">
                <option value="">-- Select Assessment Type --</option>
            </select>
        </div>
        <div class="btn-group">
            <button class="btn btn-primary-modern btn-modern" onclick="loadImages()">
                <i class="fas fa-search"></i> Load Images
            </button>
            <button class="btn btn-secondary-modern btn-modern" onclick="clearFilter()">
                <i class="fas fa-times"></i> Clear
            </button>
        </div>
    </div>
</div>

<div id="statsBar" style="display:none;" class="stats-bar"></div>

<div id="imagesContainer">
    <div class="empty-state">
        <i class="fas fa-images"></i>
        <h4>No Images Selected</h4>
        <p>Select an assessment type to view the image gallery</p>
    </div>
</div>

<!-- ════════════════════════════════════════════
     GALLERY LIGHTBOX
════════════════════════════════════════════ -->
<div id="galleryModal" role="dialog" aria-modal="true" aria-label="Image Gallery">

    <!-- Header -->
    <div class="gm-header">
        <div class="gm-title" id="gmTitle">Image Preview</div>
        <div class="gm-counter" id="gmCounter"></div>
        <button class="gm-close" id="gmClose" title="Close (Esc)"><i class="fas fa-times"></i></button>
    </div>

    <!-- Body: image stage + info panel -->
    <div class="gm-body">

        <!-- Stage -->
        <div class="gm-stage">
            <button class="gm-arrow" id="gmPrev" title="Previous (←)"><i class="fas fa-chevron-left"></i></button>
            <img id="gmImage" class="gm-stage-img" src="" alt="Gallery image">
            <button class="gm-arrow" id="gmNext" title="Next (→)"><i class="fas fa-chevron-right"></i></button>
        </div>

        <!-- Info Panel -->
        <div class="gm-info-panel">
            <div class="gm-tabs">
                <div class="gm-tab active" data-tab="details">Details</div>
                <div class="gm-tab" data-tab="camera">Camera</div>
                <div class="gm-tab" data-tab="exif">EXIF</div>
            </div>
            <div class="gm-info-body" id="gmInfoBody"></div>
        </div>

    </div>

    <!-- Filmstrip -->
    <div class="gm-filmstrip" id="gmFilmstrip"></div>

</div>

@section Scripts {
    <script>
        /* ════════════════════════════════════════
           State
        ════════════════════════════════════════ */
        let currentImages = [];
        let gmSlides      = [];
        let gmIndex       = 0;
        let gmActiveTab   = 'details';

        /* ════════════════════════════════════════
           Init
        ════════════════════════════════════════ */
        $(document).ready(function () {
            loadAssessmentTypes();

            // Auto-load from query string
            const type = new URLSearchParams(window.location.search).get('type');
            if (type) {
                setTimeout(() => { $('#assessmentTypeFilter').val(type); loadImages(); }, 500);
            }

            // Tab clicks
            $(document).on('click', '.gm-tab', function () {
                gmActiveTab = $(this).data('tab');
                $('.gm-tab').removeClass('active');
                $(this).addClass('active');
                renderInfoPanel();
            });

            // Close
            $('#gmClose').on('click', closeGallery);
            $('#galleryModal').on('click', function (e) {
                if (e.target === this) closeGallery();
            });

            // Arrows
            $('#gmPrev').on('click', () => navigateTo(gmIndex - 1));
            $('#gmNext').on('click', () => navigateTo(gmIndex + 1));

            // Keyboard
            $(document).on('keydown', function (e) {
                if (!$('#galleryModal').hasClass('active')) return;
                if (e.key === 'ArrowLeft')  navigateTo(gmIndex - 1);
                if (e.key === 'ArrowRight') navigateTo(gmIndex + 1);
                if (e.key === 'Escape')     closeGallery();
            });
        });

        /* ════════════════════════════════════════
           API
        ════════════════════════════════════════ */
        function loadAssessmentTypes() {
            $.ajax({
                url: buildApiUrl('/Admin/GetAllAssessmentTypes'),
                type: 'GET',
                success: function (res) {
                    if (res.success && res.data) {
                        const sel = $('#assessmentTypeFilter');
                        res.data.forEach(t => {
                            const code = t.atmCode || t.AtmCode || '';
                            const name = t.atmName || t.AtmName || '';
                            if (code) sel.append(`<option value="${escHtml(code)}">${escHtml(name)}</option>`);
                        });
                    }
                }
            });
        }

        function loadImages() {
            const assessmentType = $('#assessmentTypeFilter').val();
            if (!assessmentType) { showAlert('Please select an assessment type', 'warning'); return; }
            showLoader();
            $.ajax({
                url: buildApiUrl('/Admin/GetImagesWithAuditTrail'),
                type: 'GET',
                data: { assessmentType },
                success: function (res) {
                    hideLoader();
                    if (res.success) { currentImages = res.data || []; displayImages(); }
                    else showAlert('Error: ' + res.message, 'danger');
                },
                error: function () { hideLoader(); showAlert('Error loading images. Please try again.', 'danger'); }
            });
        }

        /* ════════════════════════════════════════
           Grid Rendering
        ════════════════════════════════════════ */
        function displayImages() {
            const container = $('#imagesContainer');
            const statsBar  = $('#statsBar');
            container.empty(); statsBar.empty();

            if (!currentImages.length) {
                container.html(`<div class="empty-state"><i class="fas fa-folder-open"></i><h4>No Images Found</h4><p>No images available for this assessment type</p></div>`);
                statsBar.hide(); return;
            }

            const totalLinked = currentImages.reduce((s, i) => s + (i.linkedImagesCount || 0), 0);
            const sizeMB = (currentImages.reduce((s, i) => s + (i.imFileSize || 0), 0) / 1048576).toFixed(2);

            statsBar.html(`
                <div class="stat-chip"><i class="fas fa-images"></i> Master Images: <span class="stat-value">${currentImages.length}</span></div>
                <div class="stat-chip"><i class="fas fa-link"></i> Linked Images: <span class="stat-value">${totalLinked}</span></div>
                <div class="stat-chip"><i class="fas fa-hdd"></i> Total Size: <span class="stat-value">${sizeMB} MB</span></div>
            `).show();

            const grid = $('<div class="images-grid"></div>');
            currentImages.forEach((img, mi) => grid.append(buildCard(img, mi)));
            container.append(grid);
        }

        function buildCard(image, mi) {
            const sizeMB     = image.imFileSize ? (image.imFileSize / 1048576).toFixed(2) : '0';
            const dims       = `${image.imWidth || 0}×${image.imHeight || 0}`;
            const dateStr    = image.imCreatedDate ? new Date(image.imCreatedDate).toLocaleDateString() : 'N/A';

            let linkedHtml = '';
            if (image.linkedImages && image.linkedImages.length) {
                const thumbs = image.linkedImages.map((li, idx) => {
                    const qc = li.ilQualityType === 'enhanced' ? 'enhanced' : 'degraded';
                    return `<div class="linked-image-thumb" onclick="event.stopPropagation();openGallery(${mi},${idx+1})" title="${escHtml(li.ilFileName||'')}">
                        <img src="${li.ilFilePath}" alt="${escHtml(li.ilFileName||'')}" loading="lazy">
                        <span class="quality-badge ${qc}">${escHtml(li.ilQualityLevel||'N/A')}</span>
                    </div>`;
                }).join('');
                linkedHtml = `<div class="linked-images-section">
                    <div class="linked-images-title"><i class="fas fa-layer-group"></i> Linked Images (${image.linkedImagesCount})</div>
                    <div class="linked-images-grid">${thumbs}</div>
                </div>`;
            }

            return `<div class="image-item">
                <div class="image-preview-container" onclick="openGallery(${mi},0)">
                    <img src="${image.imFilePath}" class="image-preview-main" alt="${escHtml(image.imFileName||'')}" loading="lazy">
                    <div class="image-badge"><i class="fas fa-link"></i> ${image.linkedImagesCount} Linked</div>
                    <div class="open-gallery-hint"><i class="fas fa-expand"></i> Open Gallery</div>
                </div>
                <div class="image-details">
                    <div class="image-title"><i class="fas fa-file-image"></i> ${trunc(image.imFileName, 32)}</div>
                    <div class="image-meta">
                        <div class="meta-item"><i class="fas fa-expand-arrows-alt"></i><span class="meta-value">${dims} px</span></div>
                        <div class="meta-item"><i class="fas fa-file"></i><span class="meta-value">${sizeMB} MB</span></div>
                        <div class="meta-item"><i class="fas fa-image"></i><span class="meta-value">${image.imFormat||'N/A'}</span></div>
                        <div class="meta-item"><i class="fas fa-calendar"></i><span class="meta-value">${dateStr}</span></div>
                    </div>
                    ${linkedHtml}
                    <div class="audit-section">
                        <div class="audit-title"><i class="fas fa-history"></i> Audit Trail</div>
                        <div class="audit-grid">
                            <div class="audit-item"><strong>By:</strong> ${escHtml(image.imCreatedUser||'N/A')}</div>
                            <div class="audit-item"><strong>Date:</strong> ${dateStr}</div>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        /* ════════════════════════════════════════
           Gallery Logic
        ════════════════════════════════════════ */
        function buildSlides(master) {
            const s = [];

            // Master slide
            s.push({
                isMaster:    true,
                filePath:    master.imFilePath,
                fileName:    master.imFileName,
                fileSize:    master.imFileSize,
                width:       master.imWidth,
                height:      master.imHeight,
                format:      master.imFormat,
                colorSpace:  master.imColorSpace,
                bitDepth:    master.imBitDepth,
                dpiX:        master.imDpiX,
                dpiY:        master.imDpiY,
                orientation: master.imOrientation,
                compressionQuality: master.imCompressionQuality,
                cameraMake:  master.imCameraMake,
                cameraModel: master.imCameraModel,
                lensModel:   master.imLensModel,
                focalLength: master.imFocalLength,
                aperture:    master.imAperture,
                shutterSpeed:master.imShutterSpeed,
                iso:         master.imIso,
                flash:       master.imFlash,
                exposureMode:master.imExposureMode,
                whiteBalance:master.imWhiteBalance,
                dateTaken:   master.imDateTaken,
                uploadBatch: master.imUploadBatch,
                createdUser: master.imCreatedUser,
                createdDate: master.imCreatedDate,
                exifData:    master.imExifData,
                qualityLevel:'RAW / Master',
                qualityType: 'master'
            });

            // Linked slides
            (master.linkedImages || []).forEach(li => {
                s.push({
                    isMaster:    false,
                    filePath:    li.ilFilePath,
                    fileName:    li.ilFileName,
                    fileSize:    li.ilFileSize,
                    width:       li.ilWidth,
                    height:      li.ilHeight,
                    format:      li.ilFormat,
                    colorSpace:  li.ilColorSpace,
                    bitDepth:    li.ilBitDepth,
                    dpiX:        li.ilDpiX,
                    dpiY:        li.ilDpiY,
                    orientation: li.ilOrientation,
                    compressionQuality: li.ilCompressionQuality,
                    cameraMake:  li.ilCameraMake,
                    cameraModel: li.ilCameraModel,
                    lensModel:   li.ilLensModel,
                    focalLength: li.ilFocalLength,
                    aperture:    li.ilAperture,
                    shutterSpeed:li.ilShutterSpeed,
                    iso:         li.ilIso,
                    flash:       li.ilFlash,
                    exposureMode:li.ilExposureMode,
                    whiteBalance:li.ilWhiteBalance,
                    dateTaken:   li.ilDateTaken,
                    uploadBatch: li.ilUploadBatch,
                    createdUser: li.ilCreatedUser,
                    createdDate: li.ilCreatedDate,
                    exifData:    li.ilExifData,
                    qualityLevel:li.ilQualityLevel || 'N/A',
                    qualityType: li.ilQualityType  || 'degraded'
                });
            });

            return s;
        }

        function openGallery(mi, slideIdx) {
            const master = currentImages[mi];
            if (!master) return;

            gmSlides    = buildSlides(master);
            gmIndex     = Math.max(0, Math.min(slideIdx, gmSlides.length - 1));
            gmActiveTab = 'details';

            // Reset tabs UI
            $('.gm-tab').removeClass('active');
            $('.gm-tab[data-tab="details"]').addClass('active');

            renderFilmstrip();
            applySlide(false);

            $('#galleryModal').addClass('active');
            $('body').css('overflow', 'hidden');
        }

        function closeGallery() {
            $('#galleryModal').removeClass('active');
            $('body').css('overflow', '');
        }

        function navigateTo(idx) {
            if (idx < 0 || idx >= gmSlides.length) return;
            const img = document.getElementById('gmImage');
            img.classList.add('fading');
            setTimeout(() => {
                gmIndex = idx;
                applySlide(false);
                img.classList.remove('fading');
            }, 160);
        }

        function applySlide(skipFade) {
            const slide = gmSlides[gmIndex];
            if (!slide) return;

            const img = document.getElementById('gmImage');
            img.src = slide.filePath || '';
            img.alt = slide.fileName || '';

            document.getElementById('gmTitle').textContent   = slide.fileName || 'Image';
            document.getElementById('gmCounter').textContent = `${gmIndex + 1} / ${gmSlides.length}`;

            document.getElementById('gmPrev').disabled = (gmIndex === 0);
            document.getElementById('gmNext').disabled = (gmIndex === gmSlides.length - 1);

            // Sync filmstrip
            document.querySelectorAll('.gm-thumb').forEach((el, i) => {
                el.classList.toggle('active', i === gmIndex);
                if (i === gmIndex) el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            });

            renderInfoPanel();
        }

        /* ── Info Panel ── */
        function renderInfoPanel() {
            const s = gmSlides[gmIndex];
            if (!s) return;

            const fmtSize = s.fileSize
                ? (s.fileSize >= 1048576
                    ? (s.fileSize / 1048576).toFixed(2) + ' MB'
                    : (s.fileSize / 1024).toFixed(1) + ' KB')
                : 'N/A';

            const fmtDate  = d => d ? new Date(d).toLocaleString() : 'N/A';
            const chip     = `<span class="gm-quality-chip ${s.qualityType}">${escHtml(s.qualityLevel)}</span>`;
            const na       = v => (v != null && v !== '') ? escHtml(String(v)) : '<span style="opacity:.35">—</span>';

            let html = '';

            if (gmActiveTab === 'details') {
                html = `
                    <div class="info-group-label">Image</div>
                    ${kv('Type', chip)}
                    ${kv('File Name', na(s.fileName))}
                    ${kv('File Size', fmtSize)}
                    ${kv('Dimensions', (s.width && s.height) ? `${s.width} × ${s.height} px` : '—')}
                    ${kv('Format', na(s.format))}
                    ${kv('Color Space', na(s.colorSpace))}
                    ${kv('Bit Depth', s.bitDepth != null ? s.bitDepth + ' bit' : '—')}
                    ${kv('DPI X', s.dpiX != null ? parseFloat(s.dpiX).toFixed(1) : '—')}
                    ${kv('DPI Y', s.dpiY != null ? parseFloat(s.dpiY).toFixed(1) : '—')}
                    ${kv('Orientation', na(s.orientation))}
                    ${kv('Compression', s.compressionQuality != null ? s.compressionQuality + '%' : '—')}
                    <div class="info-group-label">Audit</div>
                    ${kv('Uploaded By', na(s.createdUser))}
                    ${kv('Upload Date', fmtDate(s.createdDate))}
                    ${kv('Batch ID', na(s.uploadBatch))}`;

            } else if (gmActiveTab === 'camera') {
                html = `
                    <div class="info-group-label">Camera</div>
                    ${kv('Make', na(s.cameraMake))}
                    ${kv('Model', na(s.cameraModel))}
                    ${kv('Lens', na(s.lensModel))}
                    <div class="info-group-label">Capture</div>
                    ${kv('Date Taken', fmtDate(s.dateTaken))}
                    ${kv('Focal Length', s.focalLength != null ? parseFloat(s.focalLength).toFixed(1) + ' mm' : '—')}
                    ${kv('Aperture', s.aperture ? 'f/' + escHtml(String(s.aperture)) : '—')}
                    ${kv('Shutter Speed', na(s.shutterSpeed))}
                    ${kv('ISO', na(s.iso))}
                    ${kv('Flash', na(s.flash))}
                    ${kv('Exposure Mode', na(s.exposureMode))}
                    ${kv('White Balance', na(s.whiteBalance))}`;

            } else { // exif
                if (s.exifData) {
                    try {
                        const exif = typeof s.exifData === 'string' ? JSON.parse(s.exifData) : s.exifData;
                        const entries = exif && typeof exif === 'object' ? Object.entries(exif).filter(([,v]) => v != null && v !== '') : [];
                        if (entries.length) {
                            html = `<div class="info-group-label">Raw EXIF Tags</div>` +
                                entries.map(([k, v]) => kv(escHtml(k), escHtml(String(v)))).join('');
                        } else {
                            html = '<div class="no-data-msg"><i class="fas fa-info-circle"></i><br>No EXIF tags found</div>';
                        }
                    } catch {
                        html = `<div class="no-data-msg" style="word-break:break-all;">${escHtml(String(s.exifData))}</div>`;
                    }
                } else {
                    html = '<div class="no-data-msg"><i class="fas fa-info-circle"></i><br>No EXIF data available</div>';
                }
            }

            document.getElementById('gmInfoBody').innerHTML = html;
        }

        function kv(key, val) {
            return `<div class="info-row"><span class="info-k">${key}</span><span class="info-v">${val}</span></div>`;
        }

        /* ── Filmstrip ── */
        function renderFilmstrip() {
            const strip = document.getElementById('gmFilmstrip');
            strip.innerHTML = gmSlides.map((s, i) => {
                const lbl = s.isMaster ? 'RAW' : escHtml(s.qualityLevel || '');
                return `<div class="gm-thumb${i === gmIndex ? ' active' : ''}" data-idx="${i}" title="${escHtml(s.fileName||'')}">
                    <img src="${s.filePath}" alt="${escHtml(s.fileName||'')}" loading="lazy">
                    <div class="gm-thumb-lbl">${lbl}</div>
                </div>`;
            }).join('');

            strip.querySelectorAll('.gm-thumb').forEach(el => {
                el.addEventListener('click', () => navigateTo(parseInt(el.dataset.idx, 10)));
            });
        }

        /* ════════════════════════════════════════
           Utilities
        ════════════════════════════════════════ */
        function clearFilter() {
            $('#assessmentTypeFilter').val('');
            $('#statsBar').hide();
            $('#imagesContainer').html(`<div class="empty-state"><i class="fas fa-images"></i><h4>No Images Selected</h4><p>Select an assessment type to view the image gallery</p></div>`);
        }

        function trunc(text, max) {
            if (!text) return 'N/A';
            return text.length > max ? text.substring(0, max) + '…' : text;
        }

        /* Local escHtml — safe even if layout version differs */
        function escHtml(text) {
            if (text == null) return '';
            return String(text).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
        }
    </script>
}