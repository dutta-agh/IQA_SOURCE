@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Assessment Images";
}

@section Styles {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
            --card-shadow-hover: 0 8px 16px rgba(102, 126, 234, 0.2);
            --border-radius: 12px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .page-header {
            background: var(--primary-gradient);
            border-radius: var(--border-radius);
            padding: 25px 30px;
            margin-bottom: 25px;
            color: white;
            box-shadow: var(--card-shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-header h2 {
            margin: 0;
            font-size: 1.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .filter-section {
            background: white;
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: var(--card-shadow);
            margin-bottom: 20px;
        }

        .filter-group {
            display: flex;
            gap: 15px;
            align-items: end;
            flex-wrap: wrap;
        }

        .filter-group .form-group {
            flex: 1;
            min-width: 250px;
            margin-bottom: 0;
        }

        .filter-group .btn-group {
            display: flex;
            gap: 10px;
        }

        .btn-modern {
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: var(--card-shadow-hover);
        }

        .btn-primary-modern {
            background: var(--primary-gradient);
            color: white;
        }

        .btn-secondary-modern {
            background: #e9ecef;
            color: #495057;
        }

        .btn-back {
            background: white;
            color: #667eea;
            border: 2px solid white;
        }

        .btn-back:hover {
            background: rgba(255, 255, 255, 0.9);
        }

        .images-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .image-item {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--card-shadow);
            transition: var(--transition);
        }

        .image-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--card-shadow-hover);
        }

        .image-preview-container {
            position: relative;
            width: 100%;
            height: 220px;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .image-preview-main {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .image-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.95);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        }

        .image-details {
            padding: 18px;
        }

        .image-title {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 10px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .image-title i {
            color: #667eea;
        }

        .image-meta {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }

        .meta-item {
            font-size: 0.8rem;
            color: #718096;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .meta-item i {
            color: #667eea;
            width: 14px;
        }

        .meta-value {
            font-weight: 500;
            color: #2d3748;
        }

        .linked-images-section {
            border-top: 1px solid #e2e8f0;
            padding-top: 12px;
            margin-top: 12px;
        }

        .linked-images-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .linked-images-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
            gap: 8px;
        }

        .linked-image-thumb {
            position: relative;
            aspect-ratio: 1;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #e2e8f0;
            transition: var(--transition);
            cursor: pointer;
        }

        .linked-image-thumb:hover {
            border-color: #667eea;
            transform: scale(1.05);
        }

        .linked-image-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .quality-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background: rgba(0, 0, 0, 0.75);
            color: white;
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 600;
            pointer-events: none;
        }

        .quality-badge.enhanced {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .quality-badge.degraded {
            background: linear-gradient(135deg, #f093fb, #f5576c);
        }

        .audit-section {
            background: #f7fafc;
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
            border-left: 3px solid #667eea;
        }

        .audit-title {
            font-size: 0.8rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .audit-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
        }

        .audit-item {
            font-size: 0.75rem;
            color: #718096;
        }

        .audit-item strong {
            color: #2d3748;
            font-weight: 500;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
        }

        .empty-state i {
            font-size: 4rem;
            color: #cbd5e0;
            margin-bottom: 20px;
        }

        .empty-state h4 {
            color: #4a5568;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #718096;
        }

        .stats-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .stat-chip {
            background: white;
            border-radius: 20px;
            padding: 8px 16px;
            box-shadow: var(--card-shadow);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .stat-chip i {
            color: #667eea;
        }

        .stat-value {
            background: var(--primary-gradient);
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .images-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .filter-group {
                flex-direction: column;
            }

            .filter-group .form-group {
                width: 100%;
            }
        }
    </style>
}

<div class="page-header">
    <h2>
        <i class="fas fa-images"></i>
        Assessment Images Gallery
    </h2>
    <a href="@IQA_SOURCE.Constants.SubApplicationPathJS/Admin/Dashboard" class="btn btn-back btn-modern">
        <i class="fas fa-arrow-left"></i> Dashboard
    </a>
</div>

<div class="filter-section">
    <div class="filter-group">
        <div class="form-group">
            <label class="form-label fw-bold"><i class="fas fa-filter"></i> Assessment Type</label>
            <select class="form-select" id="assessmentTypeFilter">
                <option value="">-- Select Assessment Type --</option>
            </select>
        </div>
        <div class="btn-group">
            <button class="btn btn-primary-modern btn-modern" onclick="loadImages()">
                <i class="fas fa-search"></i> Load Images
            </button>
            <button class="btn btn-secondary-modern btn-modern" onclick="clearFilter()">
                <i class="fas fa-times"></i> Clear
            </button>
        </div>
    </div>
</div>

<div id="statsBar" style="display: none;" class="stats-bar"></div>

<div id="imagesContainer">
    <div class="empty-state">
        <i class="fas fa-images"></i>
        <h4>No Images Selected</h4>
        <p>Select an assessment type to view the image gallery</p>
    </div>
</div>

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header" style="background: var(--primary-gradient); color: white; border: none;">
                <h5 class="modal-title" id="previewModalTitle">
                    <i class="fas fa-image"></i> Image Preview
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" style="background: #f8f9fa; padding: 30px;">
                <img id="previewImage" class="img-fluid" style="max-height: 75vh; border-radius: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.2);">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentImages = [];

        $(document).ready(function() {
            loadAssessmentTypes();
            
            const urlParams = new URLSearchParams(window.location.search);
            const assessmentType = urlParams.get('type');
            if (assessmentType) {
                setTimeout(() => {
                    $('#assessmentTypeFilter').val(assessmentType);
                    loadImages();
                }, 500);
            }
        });

        function loadAssessmentTypes() {
            $.ajax({
                url: buildApiUrl('/Admin/GetAllAssessmentTypes'),
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        const select = $('#assessmentTypeFilter');
                        response.data.forEach(at => {
                            select.append(`<option value="${escapeHtml(at.atmCode)}">${escapeHtml(at.atmName)}</option>`);
                        });
                    }
                },
                error: function() {
                    showAlert('Error loading assessment types', 'danger');
                }
            });
        }

        function loadImages() {
            const assessmentType = $('#assessmentTypeFilter').val();
            if (!assessmentType) {
                showAlert('Please select an assessment type', 'warning');
                return;
            }

            showLoader();
            $.ajax({
                url: buildApiUrl('/Admin/GetImagesWithAuditTrail'),
                type: 'GET',
                data: { assessmentType: assessmentType },
                success: function(response) {
                    hideLoader();
                    if (response.success) {
                        currentImages = response.data || [];
                        displayImages();
                    } else {
                        showAlert('Error: ' + response.message, 'danger');
                    }
                },
                error: function(xhr, status, error) {
                    hideLoader();
                    console.error('Error loading images:', error);
                    showAlert('Error loading images. Please try again.', 'danger');
                }
            });
        }

        function displayImages() {
            const container = $('#imagesContainer');
            const statsBar = $('#statsBar');
            container.empty();
            statsBar.empty();

            if (currentImages.length === 0) {
                container.html(`
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h4>No Images Found</h4>
                        <p>No images available for this assessment type</p>
                    </div>
                `);
                statsBar.hide();
                return;
            }

            // Display stats
            const totalLinked = currentImages.reduce((sum, img) => sum + img.linkedImagesCount, 0);
            const totalSize = currentImages.reduce((sum, img) => sum + (img.imFileSize || 0), 0);
            const sizeMB = (totalSize / (1024 * 1024)).toFixed(2);

            statsBar.html(`
                <div class="stat-chip">
                    <i class="fas fa-images"></i>
                    Master Images: <span class="stat-value">${currentImages.length}</span>
                </div>
                <div class="stat-chip">
                    <i class="fas fa-link"></i>
                    Linked Images: <span class="stat-value">${totalLinked}</span>
                </div>
                <div class="stat-chip">
                    <i class="fas fa-hdd"></i>
                    Total Size: <span class="stat-value">${sizeMB} MB</span>
                </div>
            `);
            statsBar.show();

            // Create grid
            const grid = $('<div class="images-grid"></div>');
            currentImages.forEach(image => {
                grid.append(createImageCard(image));
            });
            container.append(grid);
        }

        function createImageCard(image) {
            const fileSize = image.imFileSize ? (image.imFileSize / (1024 * 1024)).toFixed(2) : '0';
            const dimensions = `${image.imWidth || 0}×${image.imHeight || 0}`;
            const createdDate = image.imCreatedDate ? new Date(image.imCreatedDate).toLocaleDateString() : 'N/A';
            
            let linkedImagesHtml = '';
            if (image.linkedImages && image.linkedImages.length > 0) {
                linkedImagesHtml = `
                    <div class="linked-images-section">
                        <div class="linked-images-title">
                            <i class="fas fa-layer-group"></i>
                            Linked Images (${image.linkedImagesCount})
                        </div>
                        <div class="linked-images-grid">
                            ${image.linkedImages.map(linked => {
                                const qualityClass = linked.ilQualityType === 'enhanced' ? 'enhanced' : 'degraded';
                                const qualityLabel = linked.ilQualityLevel || 'N/A';
                                return `
                                    <div class="linked-image-thumb" onclick="event.stopPropagation(); previewImage('${linked.ilFilePath}', '${escapeHtml(linked.ilFileName)}')">
                                        <img src="${linked.ilFilePath}" alt="${escapeHtml(linked.ilFileName)}">
                                        <span class="quality-badge ${qualityClass}">${qualityLabel}</span>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    </div>
                `;
            }

            return `
                <div class="image-item">
                    <div class="image-preview-container" onclick="previewImage('${image.imFilePath}', '${escapeHtml(image.imFileName)}')">
                        <img src="${image.imFilePath}" class="image-preview-main" alt="${escapeHtml(image.imFileName)}">
                        <div class="image-badge">
                            <i class="fas fa-link"></i>
                            ${image.linkedImagesCount} Linked
                        </div>
                    </div>
                    <div class="image-details">
                        <div class="image-title">
                            <i class="fas fa-file-image"></i>
                            ${truncateText(image.imFileName, 30)}
                        </div>
                        <div class="image-meta">
                            <div class="meta-item">
                                <i class="fas fa-expand-arrows-alt"></i>
                                <span class="meta-value">${dimensions} px</span>
                            </div>
                            <div class="meta-item">
                                <i class="fas fa-file"></i>
                                <span class="meta-value">${fileSize} MB</span>
                            </div>
                            <div class="meta-item">
                                <i class="fas fa-image"></i>
                                <span class="meta-value">${image.imFormat || 'N/A'}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fas fa-calendar"></i>
                                <span class="meta-value">${createdDate}</span>
                            </div>
                        </div>
                        ${linkedImagesHtml}
                        <div class="audit-section">
                            <div class="audit-title">
                                <i class="fas fa-history"></i>
                                Audit Trail
                            </div>
                            <div class="audit-grid">
                                <div class="audit-item">
                                    <strong>By:</strong> ${image.imCreatedUser || 'N/A'}
                                </div>
                                <div class="audit-item">
                                    <strong>Date:</strong> ${createdDate}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function truncateText(text, maxLength) {
            if (!text) return 'N/A';
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        function previewImage(imagePath, fileName) {
            $('#previewModalTitle').html(`<i class="fas fa-image"></i> ${escapeHtml(fileName)}`);
            $('#previewImage').attr('src', imagePath);
            new bootstrap.Modal(document.getElementById('imagePreviewModal')).show();
        }

        function clearFilter() {
            $('#assessmentTypeFilter').val('');
            $('#statsBar').hide();
            $('#imagesContainer').html(`
                <div class="empty-state">
                    <i class="fas fa-images"></i>
                    <h4>No Images Selected</h4>
                    <p>Select an assessment type to view the image gallery</p>
                </div>
            `);
        }
    </script>
}