@{
    ViewData["Title"] = "Welcome to IQA";
    Layout = "_AssessmentLayout";
    var assessmentType = ViewBag.AssessmentType as string ?? "";
}

@section Styles {
    <style>
        .content-card {
            background-color: white !im;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 900px;
            width: 100%;
            animation: fadeInUp 0.6s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .intro-content {
            min-height: 300px;
            margin-bottom: 30px;
            line-height: 1.8;
            color: #333;
        }

        .start-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 15px 50px;
            font-size: 1.2rem;
            border-radius: 50px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .start-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .loader-overlay.show {
            display: flex;
        }

        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loader-text {
            color: white;
            margin-top: 15px;
            font-size: 1.1rem;
        }

        .alert-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9998;
            max-width: 400px;
        }

        .private-mode-warning {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .private-mode-warning.show {
            display: flex;
        }

        .warning-content {
            background: white;
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            max-width: 600px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }

        .warning-icon {
            font-size: 5rem;
            color: #ff6b6b;
            margin-bottom: 20px;
        }

        .warning-content h2 {
            color: #333;
            margin-bottom: 20px;
        }

        .warning-content p {
            color: #666;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .instruction-list {
            text-align: left;
            margin: 20px auto;
            max-width: 500px;
        }

        .instruction-list li {
            margin-bottom: 10px;
            padding-left: 10px;
        }

        .browser-instructions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .browser-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
        }

        .browser-card strong {
            color: #667eea;
            display: block;
            margin-bottom: 5px;
        }
    </style>
}

<!-- Private Mode Warning -->
<div class="private-mode-warning" id="privateModeWarning">
    <div class="warning-content">
        <div class="warning-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h2>Private/Incognito Mode Required</h2>
        <p>This assessment must be accessed using your browser's private/incognito mode to ensure data privacy and test integrity.</p>
        
        <div class="browser-instructions">
            <div class="browser-card">
                <strong><i class="fab fa-chrome"></i> Chrome</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-firefox"></i> Firefox</strong>
                <small>Ctrl + Shift + P</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-edge"></i> Edge</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-safari"></i> Safari</strong>
                <small>Cmd + Shift + N</small>
            </div>
        </div>

        <div class="instruction-list">
            <p style="margin-top: 30px;"><strong>Steps to access this page:</strong></p>
            <ol>
                <li>Close this browser window</li>
                <li>Open a new private/incognito window using the shortcut above</li>
                <li>Navigate back to this URL</li>
                <li>The assessment will load automatically</li>
            </ol>
        </div>
    </div>
</div>

<!-- Loader Overlay -->
<div class="loader-overlay" id="loaderOverlay">
    <div class="text-center">
        <div class="spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>
</div>

<!-- Alert Container -->
<div class="alert-container" id="alertContainer"></div>

<!-- Main Content -->
<div class="main-container">
    <div class="content-card" style="max-width:95%;">
        <div class="intro-content" id="introContent">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading content...</p>
            </div>
        </div>

        <div class="text-center">
            <button class="btn start-btn" onclick="startAssessment()">
                <i class="fas fa-play-circle"></i> Start Assessment
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const assessmentType = '@assessmentType';

        // Initialize on page load using detect-incognito library
        (async function() {
            console.log('=== Private Mode Detection Started (using detect-incognito) ===');
            console.log('Assessment type:', assessmentType);
            
            try {
                // Use the detect-incognito library
                const result = await detectIncognito();
                console.log('=== Detection Result ===', result);
                console.log('Is Private/Incognito:', result.isPrivate);
                console.log('Browser Name:', result.browserName);
                
                if (!result.isPrivate) {
                    console.warn('⚠️ BLOCKING ACCESS - Not in private/incognito mode');
                    document.getElementById('privateModeWarning').classList.add('show');
                    // Hide main content
                    document.querySelector('.header').style.display = 'none';
                    document.querySelector('.main-container').style.display = 'none';
                    document.querySelector('.footer').style.display = 'none';
                } else {
                    console.log('✓ ALLOWING ACCESS - Private mode confirmed');
                    // Store incognito status for speed test
                    sessionStorage.setItem('incognitoVerified', 'true');
                    // Load content normally
                    loadIntroContent();
                }
            } catch (error) {
                console.error('Private mode detection error:', error);
                // On error, allow access (fail-open approach)
                console.log('Allowing access due to detection error');
                loadIntroContent();
            }
        })();

        // Loader functions
        function showLoader() {
            document.getElementById('loaderOverlay').classList.add('show');
        }

        function hideLoader() {
            document.getElementById('loaderOverlay').classList.remove('show');
        }

        // Alert functions
        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId = 'alert-' + Date.now();

            const alertHtml = `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;

            alertContainer.insertAdjacentHTML('beforeend', alertHtml);

            // Auto-dismiss after 5 seconds
            setTimeout(() => {
                const alertElement = document.getElementById(alertId);
                if (alertElement) {
                    const bsAlert = new bootstrap.Alert(alertElement);
                    bsAlert.close();
                }
            }, 5000);
        }

        // Load intro content
        function loadIntroContent() {
            showLoader();
            
            const url = buildApiUrl('/Assessment/GetIntroContent');
            
            console.log('Loading intro content from:', url);
            
            $.ajax({
                url: url,
                type: 'GET',
                data: { assessmentType: assessmentType },
                dataType: 'json',
                success: function(response) {
                    console.log('Response received:', response);
                    hideLoader();
                    
                    if (response.success && response.data) {
                        $('#introContent').html(response.data.cmContent);
                        
                        if (response.data.sessionId) {
                            sessionStorage.setItem('assessmentSessionId', response.data.sessionId);
                        }
                    } else {
                        console.warn('Response unsuccessful or no data:', response);
                        $('#introContent').html(`
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Welcome to IQA Assessment Platform</strong>
                                <p class="mt-2">Please click the button below to start your assessment.</p>
                            </div>
                        `);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', {
                        status: status,
                        error: error,
                        xhr: xhr,
                        responseText: xhr.responseText
                    });
                    hideLoader();
                    
                    let errorMessage = 'Error loading content. Please refresh the page.';
                    if (xhr.status === 404) {
                        errorMessage = 'Content endpoint not found. Please check your routing configuration.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Network error. Please check your connection.';
                    }
                    
                    $('#introContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            <strong>${errorMessage}</strong>
                            <p class="mt-2"><small>Status: ${xhr.status} - ${error}</small></p>
                        </div>
                    `);
                    
                    showAlert(errorMessage, 'danger');
                }
            });
        }

        // Start assessment - redirect to speed test
        function startAssessment() {
            showLoader();
            const url = assessmentType ? `/Assessment/${assessmentType}/SpeedTest` : '/Assessment/SpeedTest';
            console.log('Redirecting to:', url);
            window.location.href = url;
        }
    </script>
}