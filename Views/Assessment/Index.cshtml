@{
    ViewData["Title"] = "Welcome to IQA";
    Layout = "_AssessmentLayout";
    var assessmentType = ViewBag.AssessmentType as string ?? "";
}

@section Styles {
    <style>
        .content-card {
            background-color: white;
            border-radius: 20px;
            padding: 40px;      
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 900px;
            width: 100%;
            animation: fadeInUp 0.6s ease-out;
           
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .intro-content {
            min-height: 300px;
            margin-bottom: 30px;
            line-height: 1.5;
            color: #333;
            font-size: clamp(0.95rem, 2.5vw, 1.2rem);
        }

        /* ── Consent Section ──────────────────────────────────────────── */
        .consent-section {
            background: linear-gradient(135deg, #f0f4f8 0%, #f8fbff 100%);
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: clamp(16px, 4vw, 24px);
            margin-bottom: clamp(20px, 5vw, 30px);
        }

        .consent-header {
            display: flex;
            align-items: center;
            gap: clamp(8px, 2vw, 12px);
            margin-bottom: clamp(12px, 3vw, 16px);
        }

        .consent-icon {
            font-size: clamp(1.2rem, 4vw, 1.6rem);
            color: #667eea;
            flex-shrink: 0;
        }

        .consent-title {
            font-size: clamp(1rem, 3vw, 1.2rem);
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        .consent-description {
            font-size: clamp(0.85rem, 2.2vw, 0.95rem);
            color: #4a5568;
            line-height: 1.6;
            margin-bottom: clamp(12px, 3vw, 16px);
        }

        .consent-checkbox-wrapper {
            display: flex;
            align-items: flex-start;
            gap: clamp(10px, 2vw, 14px);
            padding: clamp(12px, 3vw, 16px);
            background: white;
            border-radius: 8px;
            border: 2px solid #cbd5e0;
            transition: all 0.2s;
        }

        .consent-checkbox-wrapper:hover {
            border-color: #a0aec0;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.1);
        }

        .consent-checkbox-wrapper input[type="checkbox"] {
            width: clamp(18px, 4vw, 20px);
            height: clamp(18px, 4vw, 20px);
            min-width: 18px;
            min-height: 18px;
            cursor: pointer;
            margin-top: 2px;
            flex-shrink: 0;
            accent-color: #667eea;
        }

        .consent-checkbox-label {
            flex: 1;
            cursor: pointer;
            font-size: clamp(0.8rem, 2.2vw, 0.95rem);
            color: #2d3748;
            line-height: 1.6;
            font-weight: 500;
            margin: 0;
        }

        .consent-checkbox-label strong {
            color: #1a202c;
            font-weight: 700;
        }

        .start-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: clamp(12px, 3vw, 15px) clamp(30px, 6vw, 50px);
            font-size: clamp(0.95rem, 2.5vw, 1.2rem);
            border-radius: 50px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            font-weight: 600;
        }

        .start-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .start-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .loader-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .loader-overlay.show { display: flex; }

        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loader-text {
            color: white;
            margin-top: 15px;
            font-size: clamp(0.9rem, 2.5vw, 1.1rem);
        }

        .alert-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9998;
            max-width: 400px;
        }

        .private-mode-warning {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .private-mode-warning.show { display: flex; }

        .warning-content {
            background: white;
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            max-width: 600px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }

        .warning-icon {
            font-size: 5rem;
            color: #ff6b6b;
            margin-bottom: 20px;
        }

        .warning-content h2 { color: #333; margin-bottom: 20px; }

        .warning-content p {
            color: #666;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .instruction-list {
            text-align: left;
            margin: 20px auto;
            max-width: 500px;
        }

        .instruction-list li {
            margin-bottom: 10px;
            padding-left: 10px;
        }

        .browser-instructions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .browser-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
        }

        .browser-card strong {
            color: #667eea;
            display: block;
            margin-bottom: 5px;
        }

        /* ── Color Vision Test Modal ──────────────────────────────────────────── */
        .color-vision-modal {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10001;
            backdrop-filter: blur(2px);
        }

        .color-vision-modal.show { display: flex; }

        .color-vision-content {
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border-radius: 24px;
            padding: clamp(40px, 8vw, 60px);
            text-align: center;
            max-width: 600px;
            width: 90%;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideInDown 0.4s ease-out forwards;
            border: 3px solid #667eea;
            transform: scale(0.85) !important;
            transform-origin: center;
            transition: transform 0.3s ease-out;
        }

        @@keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .color-vision-icon {
            font-size: clamp(3rem, 8vw, 4.5rem);
            color: #667eea;
            margin-bottom: clamp(16px, 4vw, 24px);
            display: block;
        }

        .color-vision-title {
            font-size: clamp(1.5rem, 5vw, 2rem);
            font-weight: 700;
            color: #2d3748;
            margin-bottom: clamp(12px, 3vw, 16px);
        }

        .color-vision-description {
            font-size: clamp(0.95rem, 2.5vw, 1.1rem);
            color: #4a5568;
            line-height: 1.8;
            margin-bottom: clamp(20px, 5vw, 30px);
        }

        .color-vision-info-box {
            background: linear-gradient(135deg, #f0f4f8 0%, #e6f0ff 100%);
            border-left: 5px solid #667eea;
            border-radius: 8px;
            padding: clamp(16px, 4vw, 20px);
            margin-bottom: clamp(20px, 5vw, 30px);
            text-align: left;
        }

        .color-vision-info-box strong {
            color: #667eea;
            display: block;
            font-size: clamp(0.9rem, 2.3vw, 1.05rem);
            margin-bottom: 8px;
        }

        .color-vision-info-box p {
            color: #4a5568;
            margin: 0;
            font-size: clamp(0.85rem, 2.2vw, 1rem);
            line-height: 1.6;
        }

        .color-vision-list {
            text-align: left;
            margin-bottom: clamp(20px, 5vw, 30px);
        }

        .color-vision-list li {
            color: #4a5568;
            margin-bottom: clamp(10px, 2vw, 14px);
            font-size: clamp(0.85rem, 2.2vw, 1rem);
            line-height: 1.6;
        }

        .color-vision-list li strong {
            color: #2d3748;
        }

        .color-vision-buttons {
            display: flex;
            gap: clamp(12px, 3vw, 16px);
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-start-test {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: clamp(12px, 2.5vw, 16px) clamp(28px, 5vw, 40px);
            font-size: clamp(0.95rem, 2.3vw, 1.1rem);
            border-radius: 50px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            font-weight: 700;
            cursor: pointer;
        }

        .btn-start-test:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .btn-cancel-test {
            background: white;
            border: 2px solid #cbd5e0;
            color: #667eea;
            padding: clamp(12px, 2.5vw, 16px) clamp(28px, 5vw, 40px);
            font-size: clamp(0.95rem, 2.3vw, 1.1rem);
            border-radius: 50px;
            transition: all 0.3s;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-cancel-test:hover {
            border-color: #667eea;
            background: #f0f4f8;
        }

        /* ── Failure overlay ─────────────────────────────────────────────── */
        .failure-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.88); z-index: 10000;
            justify-content: center; align-items: center;
        }
        .failure-overlay.show { display: flex; }
        .failure-content {
            background: white; border-radius: 20px;
            padding: 50px 60px; text-align: center;
            max-width: 560px; width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            animation: popIn 0.3s ease-out forwards;
        }
        .failure-icon { font-size: 4rem; color: #dc3545; margin-bottom: 20px; }
        .failure-content h2 { color: #2d3748; font-size: 1.6rem; font-weight: 700; margin-bottom: 12px; }
        .failure-content p  { color: #718096; font-size: 1rem; line-height: 1.7; margin-bottom: 0; }

        @@media (max-width: 768px) {
            .content-card {
                padding: clamp(20px, 5vw, 30px);
            }

            .color-vision-buttons {
                flex-direction: column;
            }

            .btn-start-test, .btn-cancel-test {
                width: 100%;
            }
        }
    </style>
}

<!-- Private Mode Warning — shown when NOT in incognito (including detection errors) -->
<div class="private-mode-warning" id="privateModeWarning">
    <div class="warning-content">
        <div class="warning-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>      
        <h2>Private/Incognito Mode Required</h2>
        <p>This assessment must be accessed using your browser's private/incognito mode to ensure data privacy and test integrity.</p>

        <div class="browser-instructions">
            <div class="browser-card">
                <strong><i class="fab fa-chrome"></i> Chrome</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-firefox"></i> Firefox</strong>
                <small>Ctrl + Shift + P</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-edge"></i> Edge</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-safari"></i> Safari</strong>
                <small>Cmd + Shift + N</small>
            </div>
        </div>

        <div class="instruction-list">
            <p style="margin-top: 30px;"><strong>Steps to access this page:</strong></p>
            <ol>
                <li>Close this browser window</li>
                <li>Open a new private/incognito window using the shortcut above</li>
                <li>Navigate back to this URL</li>
                <li>The assessment will load automatically</li>
            </ol>
        </div>
    </div>
</div>

<!-- ✅ Color Vision Test Modal — shown before redirecting to ColorblindnessTest -->
<div class="color-vision-modal" id="colorVisionModal">
    <div class="color-vision-content">
        <i class="fas fa-eye color-vision-icon"></i>
        <h2 class="color-vision-title">Color Vision Test</h2>
        
        <p class="color-vision-description">
            You are about to begin the <strong>Color Vision Test</strong>. This test helps us understand your color perception abilities.
        </p>

        <div class="color-vision-info-box">
            <strong><i class="fas fa-info-circle"></i> Test Overview</strong>
            <p>Now 12 Ishihara Color Plates. From there you to choose the correct number displayed in the image. You'll have 5 seconds per image to choose.</p>
        </div>

        <ul class="color-vision-list">
            <li><strong>12 Color Plates:</strong> You will be shown 12 different Ishihara color plates</li>
            <li><strong>Read the Number:</strong> Identify the correct number displayed in each plate</li>
            <li><strong>5 Seconds Per Image:</strong> You have a limited time to make your selection</li>
            <li><strong>Quick Responses:</strong> Try to respond as quickly and accurately as possible</li>
        </ul>

        <div class="color-vision-buttons">
            <button class="btn-start-test" onclick="proceedToColorVisionTest()">
                <i class="fas fa-play-circle"></i> Start Test
            </button>
            <button class="btn-cancel-test" onclick="cancelColorVisionTest()">
                <i class="fas fa-times-circle"></i> Cancel
            </button>
        </div>
    </div>
</div>

<!-- Loader Overlay -->
<div class="loader-overlay" id="loaderOverlay">
    <div class="text-center">
        <div class="spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>
</div>

<!-- Alert Container -->
<div class="alert-container" id="alertContainer"></div>


<!-- Main Content — hidden by default until incognito is confirmed -->
<div class="main-container" id="mainContainer" style="display:none;">
    <div class="content-card" style="max-width:76%;">
        <div class="intro-content" id="introContent">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading content...</p>
            </div>
        </div>

        <!-- Consent Section — appears between intro and start button -->
        <div class="consent-section">
            <p class="consent-description">
                By participating in this research, you acknowledge that you have read and understood 
                the information about this study.
            </p>
            <div class="consent-checkbox-wrapper">
                <input 
                    type="checkbox" 
                    id="consentCheckbox" 
                    onchange="toggleStartButton()">
                <label for="consentCheckbox" class="consent-checkbox-label">
                     I confirm that I am <strong>18 years or older</strong>, I participate 
                    <strong>voluntarily</strong>, and I understand my responses are collected 
                    <strong>anonymously for research purposes</strong>.
                </label>
            </div>
        </div>

        <div class="text-center">
            <button class="btn start-btn" id="startButton" onclick="startAssessment()" disabled>
                <i class="fas fa-play-circle"></i> Start Assessment
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const assessmentType = '@assessmentType';

        /**
         * Blocks access by showing the warning overlay and hiding all page content.
         * Called when NOT in incognito — including on any detection error (fail-closed).
         */
        function blockAccess() {
            document.getElementById('privateModeWarning').classList.add('show');
            document.querySelector('.header').style.display       = 'none';
            document.getElementById('mainContainer').style.display = 'none';
            document.querySelector('.footer').style.display        = 'none';
        }

        /**
         * Allows access: shows the main content and loads the intro.
         */
        function allowAccess() {
            sessionStorage.setItem('incognitoVerified', 'true');
            document.getElementById('mainContainer').style.display = 'flex';
            loadIntroContent();
        }

        /**
         * Toggle the Start Assessment button based on consent checkbox.
         */
        function toggleStartButton() {
            const checkbox = document.getElementById('consentCheckbox');
            const button = document.getElementById('startButton');
            button.disabled = !checkbox.checked;
        }

        // ── Incognito gate — FAIL-CLOSED ─────────────────────────────────────────
        // Uses the shared promise kicked off in _AssessmentLayout.
        // Any result where isPrivate !== true is treated as blocked.
        (async function () {
            try {
                const result = await window.checkIncognito();
                if (result.isPrivate === true) {
                    allowAccess();
                } else {
                    blockAccess();
                }
            } catch (err) {
                // Detection threw — fail-closed: block access
                console.error('Incognito detection error — blocking access:', err);
                blockAccess();
            }
        })();

        function showLoader() {
            document.getElementById('loaderOverlay').classList.add('show');
        }

        function hideLoader() {
            document.getElementById('loaderOverlay').classList.remove('show');
        }

        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId        = 'alert-' + Date.now();
            alertContainer.insertAdjacentHTML('beforeend', `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`);
            setTimeout(() => {
                const el = document.getElementById(alertId);
                if (el) new bootstrap.Alert(el).close();
            }, 5000);
        }

        function loadIntroContent() {
            showLoader();
            $.ajax({
                url:      buildApiUrl('/Assessment/GetIntroContent'),
                type:     'GET',
                data:     { assessmentType },
                dataType: 'json',
                success: function (response) {
                    hideLoader();
                    if (response.success && response.data) {
                        $('#introContent').html(response.data.cmContent);
                        if (response.data.sessionId)
                            sessionStorage.setItem('assessmentSessionId', response.data.sessionId);
                    } else {
                        $('#introContent').html(`
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Welcome to IQA Assessment Platform</strong>
                                <p class="mt-2">Please click the button below to start your assessment.</p>
                            </div>`);
                    }
                },
                error: function (xhr, status, error) {
                    hideLoader();
                    const msg = xhr.status === 404
                        ? 'Content endpoint not found.'
                        : xhr.status === 0
                            ? 'Network error. Please check your connection.'
                            : 'Error loading content. Please refresh the page.';
                    $('#introContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            <strong>${msg}</strong>
                            <p class="mt-2"><small>Status: ${xhr.status} — ${error}</small></p>
                        </div>`);
                    showAlert(msg, 'danger');
                }
            });
        }

        /**
         * ✅ NEW: Show color vision test modal before redirecting
         */
        function showColorVisionModal() {
            document.getElementById('colorVisionModal').classList.add('show');
        }

        /**
         * ✅ NEW: Hide color vision test modal
         */
        function hideColorVisionModal() {
            document.getElementById('colorVisionModal').classList.remove('show');
        }

        /**
         * ✅ NEW: Proceed to colorblindness test after acknowledging
         */
        function proceedToColorVisionTest() {
            hideColorVisionModal();
            const url = buildApiUrl('/Assessment/' + encodeURIComponent(assessmentType) + '/ColorblindnessTest');
            navigateTo(url);
        }

        /**
         * ✅ NEW: Cancel and close modal
         */
        function cancelColorVisionTest() {
            hideColorVisionModal();
            showAlert('Color vision test cancelled. You can start again whenever you are ready.', 'info');
        }

        function startAssessment() {
            const checkbox = document.getElementById('consentCheckbox');
            if (!checkbox.checked) {
                showAlert('You must accept the consent to proceed.', 'warning');
                return;
            }
            showLoader();
            
            // Check if colorblindness test is enabled
            $.ajax({
                url: buildApiUrl('/Assessment/GetAssessmentSettings'),
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    hideLoader();
                    if (response.success && response.data) {
                        const isColorblindnessEnabled = response.data.isColorblindnessEnabled;
                        
                        if (isColorblindnessEnabled) {
                            // ✅ UPDATED: Show color vision modal instead of direct redirect
                            showColorVisionModal();
                        } else {
                            // Route directly to SpeedTest: /{assessmentType}/SpeedTest
                            const url = buildApiUrl('/Assessment/' + encodeURIComponent(assessmentType) + '/SpeedTest');
                            navigateTo(url);
                        }
                    } else {
                        // Default to SpeedTest if unable to fetch settings
                        const url = buildApiUrl('/Assessment/' + encodeURIComponent(assessmentType) + '/SpeedTest');
                        navigateTo(url);
                    }
                },
                error: function (xhr, status, error) {
                    hideLoader();
                    console.error('Error checking assessment settings:', error);
                    // Default to SpeedTest on error
                    const url = buildApiUrl('/Assessment/' + encodeURIComponent(assessmentType) + '/SpeedTest');
                    navigateTo(url);    
                }
            });
        }

        // Global error handler for demonstration (logs and shows a friendly message)
        window.onerror = function (message, source, lineno, colno, error) {
            console.error('Global error caught:', { message, source, lineno, colno, error });
            document.getElementById('failureMessage').innerText = message || 'Unknown error occurred';
            document.getElementById('failureOverlay').classList.add('show');
            // Optionally, navigate to a dedicated error page or take other actions
        };

        // Close failure overlay on background click
        document.getElementById('failureOverlay').onclick = function (event) {
            if (event.target === this) {
                this.classList.remove('show');
            }
        };
    </script>
}