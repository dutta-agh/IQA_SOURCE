@{
    ViewData["Title"] = "Welcome to IQA";
    Layout = "_AssessmentLayout";
    var assessmentType = ViewBag.AssessmentType as string ?? "";
}

@section Styles {
    <style>
        .content-card {
            background-color: white;
            border-radius: 20px;
            padding: 40px;      
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 900px;
            width: 100%;
            animation: fadeInUp 0.6s ease-out;
           
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .intro-content {
            min-height: 300px;
            margin-bottom: 30px;
            line-height: 1.5;
            color: #333;
            font-size: 1.2rem;
        }

        .start-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 15px 50px;
            font-size: 1.2rem;
            border-radius: 50px;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .start-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .loader-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .loader-overlay.show { display: flex; }

        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #667eea;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loader-text {
            color: white;
            margin-top: 15px;
            font-size: 1.1rem;
        }

        .alert-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9998;
            max-width: 400px;
        }

        .private-mode-warning {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.95);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }

        .private-mode-warning.show { display: flex; }

        .warning-content {
            background: white;
            padding: 50px;
            border-radius: 20px;
            text-align: center;
            max-width: 600px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        }

        .warning-icon {
            font-size: 5rem;
            color: #ff6b6b;
            margin-bottom: 20px;
        }

        .warning-content h2 { color: #333; margin-bottom: 20px; }

        .warning-content p {
            color: #666;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .instruction-list {
            text-align: left;
            margin: 20px auto;
            max-width: 500px;
        }

        .instruction-list li {
            margin-bottom: 10px;
            padding-left: 10px;
        }

        .browser-instructions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .browser-card {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
        }

        .browser-card strong {
            color: #667eea;
            display: block;
            margin-bottom: 5px;
        }

        /* ── Failure overlay ─────────────────────────────────────────────── */
        .failure-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.88); z-index: 10000;
            justify-content: center; align-items: center;
        }
        .failure-overlay.show { display: flex; }
        .failure-content {
            background: white; border-radius: 20px;
            padding: 50px 60px; text-align: center;
            max-width: 560px; width: 90%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
            animation: popIn 0.3s ease-out forwards;
        }
        .failure-icon { font-size: 4rem; color: #dc3545; margin-bottom: 20px; }
        .failure-content h2 { color: #2d3748; font-size: 1.6rem; font-weight: 700; margin-bottom: 12px; }
        .failure-content p  { color: #718096; font-size: 1rem; line-height: 1.7; margin-bottom: 0; }
    </style>
}

<!-- Private Mode Warning — shown when NOT in incognito (including detection errors) -->
<div class="private-mode-warning" id="privateModeWarning">
    <div class="warning-content">
        <div class="warning-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h2>Private/Incognito Mode Required</h2>
        <p>This assessment must be accessed using your browser's private/incognito mode to ensure data privacy and test integrity.</p>

        <div class="browser-instructions">
            <div class="browser-card">
                <strong><i class="fab fa-chrome"></i> Chrome</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-firefox"></i> Firefox</strong>
                <small>Ctrl + Shift + P</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-edge"></i> Edge</strong>
                <small>Ctrl + Shift + N</small>
            </div>
            <div class="browser-card">
                <strong><i class="fab fa-safari"></i> Safari</strong>
                <small>Cmd + Shift + N</small>
            </div>
        </div>

        <div class="instruction-list">
            <p style="margin-top: 30px;"><strong>Steps to access this page:</strong></p>
            <ol>
                <li>Close this browser window</li>
                <li>Open a new private/incognito window using the shortcut above</li>
                <li>Navigate back to this URL</li>
                <li>The assessment will load automatically</li>
            </ol>
        </div>
    </div>
</div>

<!-- Loader Overlay -->
<div class="loader-overlay" id="loaderOverlay">
    <div class="text-center">
        <div class="spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>
</div>

<!-- Alert Container -->
<div class="alert-container" id="alertContainer"></div>


<!-- Main Content — hidden by default until incognito is confirmed -->
<div class="main-container" id="mainContainer" style="display:none;">
    <div class="content-card" style="max-width:76%;">
        <div class="intro-content" id="introContent">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading content...</p>
            </div>
        </div>
        <div class="text-center">
            <button class="btn start-btn" onclick="startAssessment()">
                <i class="fas fa-play-circle"></i> Start Assessment
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const assessmentType = '@assessmentType';

        /**
         * Blocks access by showing the warning overlay and hiding all page content.
         * Called when NOT in incognito — including on any detection error (fail-closed).
         */
        function blockAccess() {
            document.getElementById('privateModeWarning').classList.add('show');
            document.querySelector('.header').style.display       = 'none';
            document.getElementById('mainContainer').style.display = 'none';
            document.querySelector('.footer').style.display        = 'none';
        }

        /**
         * Allows access: shows the main content and loads the intro.
         */
        function allowAccess() {
            sessionStorage.setItem('incognitoVerified', 'true');
            document.getElementById('mainContainer').style.display = 'flex';
            loadIntroContent();
        }

        // ── Incognito gate — FAIL-CLOSED ─────────────────────────────────────────
        // Uses the shared promise kicked off in _AssessmentLayout.
        // Any result where isPrivate !== true is treated as blocked.
        (async function () {
            try {
                const result = await window.checkIncognito();
                if (result.isPrivate === true) {
                    allowAccess();
                } else {
                    blockAccess();
                }
            } catch (err) {
                // Detection threw — fail-closed: block access
                console.error('Incognito detection error — blocking access:', err);
                blockAccess();
            }
        })();

        function showLoader() {
            document.getElementById('loaderOverlay').classList.add('show');
        }

        function hideLoader() {
            document.getElementById('loaderOverlay').classList.remove('show');
        }

        function showAlert(message, type = 'info') {
            const alertContainer = document.getElementById('alertContainer');
            const alertId        = 'alert-' + Date.now();
            alertContainer.insertAdjacentHTML('beforeend', `
                <div id="${alertId}" class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-circle' : type === 'warning' ? 'exclamation-triangle' : 'info-circle'}"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`);
            setTimeout(() => {
                const el = document.getElementById(alertId);
                if (el) new bootstrap.Alert(el).close();
            }, 5000);
        }

        function loadIntroContent() {
            showLoader();
            $.ajax({
                url:      buildApiUrl('/Assessment/GetIntroContent'),
                type:     'GET',
                data:     { assessmentType },
                dataType: 'json',
                success: function (response) {
                    hideLoader();
                    if (response.success && response.data) {
                        $('#introContent').html(response.data.cmContent);
                        if (response.data.sessionId)
                            sessionStorage.setItem('assessmentSessionId', response.data.sessionId);
                    } else {
                        $('#introContent').html(`
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Welcome to IQA Assessment Platform</strong>
                                <p class="mt-2">Please click the button below to start your assessment.</p>
                            </div>`);
                    }
                },
                error: function (xhr, status, error) {
                    hideLoader();
                    const msg = xhr.status === 404
                        ? 'Content endpoint not found.'
                        : xhr.status === 0
                            ? 'Network error. Please check your connection.'
                            : 'Error loading content. Please refresh the page.';
                    $('#introContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            <strong>${msg}</strong>
                            <p class="mt-2"><small>Status: ${xhr.status} — ${error}</small></p>
                        </div>`);
                    showAlert(msg, 'danger');
                }
            });
        }

        function startAssessment() {
            showLoader();
            const url = assessmentType
                ? buildApiUrl(`/Assessment/${assessmentType}/SpeedTest`)
                : buildApiUrl('/Assessment/SpeedTest');
            navigateTo(url);
        }

        // Global error handler for demonstration (logs and shows a friendly message)
        window.onerror = function (message, source, lineno, colno, error) {
            console.error('Global error caught:', { message, source, lineno, colno, error });
            document.getElementById('failureMessage').innerText = message || 'Unknown error occurred';
            document.getElementById('failureOverlay').classList.add('show');
            // Optionally, navigate to a dedicated error page or take other actions
        };

        // Close failure overlay on background click
        document.getElementById('failureOverlay').onclick = function (event) {
            if (event.target === this) {
                this.classList.remove('show');
            }
        };
    </script>
}